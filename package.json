{
  "name": "api_fundamentals",
  "version": "1.0.0",
  "description": "Creating an API from scratch to get across back end concepts in greater depth",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@types/chess.js": "^0.13.7",
    "chess.js": "^1.4.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "install": "^0.13.0",
    "npm": "^12.2.1",
    "uuid": "^14.0.3"
  }
}
